{
  "version": 1,
  "state": [
    {
      "id": "free",
      "when": {
        "eq": [
          {
            "var": "held"
          },
          "(c1 :> {} @@ c2 :> {} @@ c3 :> {})"
        ]
      },
      "label": "All connections free"
    },
    {
      "id": "held",
      "when": true,
      "label": "Clients hold connections"
    }
  ],
  "step": [
    {
      "id": "acquire",
      "when": {
        "eq": [
          {
            "action": true
          },
          "Acquire"
        ]
      },
      "label": "Client takes a free connection"
    },
    {
      "id": "release",
      "when": {
        "eq": [
          {
            "action": true
          },
          "Release"
        ]
      },
      "label": "Client gives back a connection"
    },
    {
      "id": "refuse",
      "when": {
        "eq": [
          {
            "action": true
          },
          "Refuse"
        ]
      },
      "label": "No free connection; refuse the client",
      "hide": true
    }
  ]
}
